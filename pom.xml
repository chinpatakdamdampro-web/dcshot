<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.discordshot</groupId>
    <artifactId>DiscordShot</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>DiscordShot</name>
    <description>Discord /screenshot command that posts BlueMap renders (Paper/Spigot plugin)</description>

    <properties>
        <!-- Compiled for Java 21 so the same jar runs on Java 21 servers (1.21.x) and newer (26.x on Java 25). -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Library versions. Bump these over time - check:
               Paper:      https://github.com/PaperMC/Paper (README shows the current version)
               JDA:        https://github.com/discord-jda/JDA/releases
               Playwright: https://github.com/microsoft/playwright-java/releases -->
        <paper.api.version>1.21.11-R0.1-SNAPSHOT</paper.api.version>
        <jda.version>6.5.0</jda.version>
        <playwright.version>1.56.0</playwright.version>
        <slf4j.version>2.0.16</slf4j.version>

        <!-- Bundled libraries are moved into this package so they can never clash with other plugins. -->
        <shade.prefix>dev.discordshot.libs</shade.prefix>

        <!-- Jar name suffix and Playwright driver folders to leave out of the jar.
             Overridden by the platform profiles at the bottom of this file. -->
        <jar.suffix></jar.suffix>
        <pw.drop.1>drop-nothing/**</pw.drop.1>
        <pw.drop.2>drop-nothing/**</pw.drop.2>
        <pw.drop.3>drop-nothing/**</pw.drop.3>
        <pw.drop.4>drop-nothing/**</pw.drop.4>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Provided by the server at runtime. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Discord bot (shaded into the plugin jar). -->
        <dependency>
            <groupId>net.dv8tion</groupId>
            <artifactId>JDA</artifactId>
            <version>${jda.version}</version>
            <exclusions>
                <!-- Audio natives: not needed for slash commands. -->
                <exclusion>
                    <groupId>club.minnced</groupId>
                    <artifactId>opus-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Headless browser automation (shaded into the plugin jar). -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}${jar.suffix}</finalName>

        <resources>
            <!-- plugin.yml gets the project version filled in. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <artifactSet>
                                <excludes>
                                    <!-- The server already provides SLF4J. -->
                                    <exclude>org.slf4j:slf4j-api</exclude>
                                </excludes>
                            </artifactSet>

                            <relocations>
                                <relocation>
                                    <pattern>net.dv8tion.jda</pattern>
                                    <shadedPattern>${shade.prefix}.jda</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.neovisionaries</pattern>
                                    <shadedPattern>${shade.prefix}.neovisionaries</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>okhttp3</pattern>
                                    <shadedPattern>${shade.prefix}.okhttp3</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>okio</pattern>
                                    <shadedPattern>${shade.prefix}.okio</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>kotlin</pattern>
                                    <shadedPattern>${shade.prefix}.kotlin</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.fasterxml.jackson</pattern>
                                    <shadedPattern>${shade.prefix}.jackson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.apache.commons.collections4</pattern>
                                    <shadedPattern>${shade.prefix}.collections4</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>gnu.trove</pattern>
                                    <shadedPattern>${shade.prefix}.trove</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.iwebpp.crypto</pattern>
                                    <shadedPattern>${shade.prefix}.iwebpp</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.crypto.tink</pattern>
                                    <shadedPattern>${shade.prefix}.tink</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.protobuf</pattern>
                                    <shadedPattern>${shade.prefix}.protobuf</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>${shade.prefix}.gson</shadedPattern>
                                </relocation>
                            </relocations>

                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                                <!-- Optionally drop Playwright drivers for other operating systems (see profiles). -->
                                <filter>
                                    <artifact>com.microsoft.playwright:driver-bundle</artifact>
                                    <excludes>
                                        <exclude>${pw.drop.1}</exclude>
                                        <exclude>${pw.drop.2}</exclude>
                                        <exclude>${pw.drop.3}</exclude>
                                        <exclude>${pw.drop.4}</exclude>
                                    </excludes>
                                </filter>
                            </filters>

                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <!-- Bukkit reads plugin.yml's own "main:" key and never looks at this - this
                                             entry only matters if someone runs `java -jar` directly (see DiscordShotCLI).
                                             No remapping hint is needed here: the plugin only calls public
                                             Bukkit/Paper API and never touches internal (NMS) classes. -->
                                        <Main-Class>dev.discordshot.DiscordShotCLI</Main-Class>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
      The Playwright driver bundle ships a Node.js runtime for EVERY operating system (~160 MB).
      These profiles build a much smaller jar for one platform: mvn package -Plinux-x64
    -->
    <profiles>
        <profile>
            <id>linux-x64</id>
            <properties>
                <jar.suffix>-linux-x64</jar.suffix>
                <pw.drop.1>driver/linux-arm64/**</pw.drop.1>
                <pw.drop.2>driver/mac/**</pw.drop.2>
                <pw.drop.3>driver/mac-arm64/**</pw.drop.3>
                <pw.drop.4>driver/win32_x64/**</pw.drop.4>
            </properties>
        </profile>
        <profile>
            <id>linux-arm64</id>
            <properties>
                <jar.suffix>-linux-arm64</jar.suffix>
                <pw.drop.1>driver/linux/**</pw.drop.1>
                <pw.drop.2>driver/mac/**</pw.drop.2>
                <pw.drop.3>driver/mac-arm64/**</pw.drop.3>
                <pw.drop.4>driver/win32_x64/**</pw.drop.4>
            </properties>
        </profile>
        <profile>
            <id>windows-x64</id>
            <properties>
                <jar.suffix>-windows-x64</jar.suffix>
                <pw.drop.1>driver/linux/**</pw.drop.1>
                <pw.drop.2>driver/linux-arm64/**</pw.drop.2>
                <pw.drop.3>driver/mac/**</pw.drop.3>
                <pw.drop.4>driver/mac-arm64/**</pw.drop.4>
            </properties>
        </profile>
    </profiles>
</project>
